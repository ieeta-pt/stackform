from rest_framework import status
from rest_framework.response import Response
from adrf.views import APIView
from drf_spectacular.utils import extend_schema

from api.access import Roles
from api.authentication.auth import find_by_password
from api.authentication.jwt_utils import create_jwt_token
from api.authentication.mongodb import get_database

{% for identity in auth.login_identities %}
{% set class_name = identity.name | capitalize_collection %}

class {{ class_name }}LoginView(APIView):
    authentication_classes = []
    permission_classes = []

    @extend_schema(tags=["{{ identity.name | capitalize_collection }}"], auth=[])
    async def post(self, request):
        identifier_value = request.data.get("{{ identity.identifier }}")
        password = request.data.get("password")
        doc = (
            await find_by_password(get_database(), "{{ identity.name }}", str(identifier_value), str(password))
            if identifier_value and password
            else None
        )
        subject = doc.get("{{ identity.id_field }}") if doc is not None else None
        if subject is None:
            return Response({"detail": "Invalid credentials"}, status=status.HTTP_401_UNAUTHORIZED)

        token = create_jwt_token(str(subject), "{{ identity.name }}")
        return Response({"token": token, **{{ identity.role_store | py_literal }}.signed_in(doc)})

{% endfor %}
