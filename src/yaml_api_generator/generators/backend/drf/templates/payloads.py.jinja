"""Serializers that check request data against spec field configs."""

from typing import Any

from rest_framework import serializers, status, views

from .fields import conform_object


class PayloadSerializer(serializers.Serializer):
    """Subclasses declare ``properties``; ``partial=True`` accepts any subset of them."""

    properties: dict[str, dict[str, Any]] = {}
    omittable = False

    def to_internal_value(self, data: Any) -> dict[str, Any]:
        try:
            return conform_object(self.properties, data, partial=self.partial or self.omittable)
        except ValueError as error:
            raise serializers.ValidationError({"detail": str(error)}) from error


def partial(serializer: type[PayloadSerializer], name: str) -> type[PayloadSerializer]:
    """``serializer`` accepting any subset of its properties."""
    return type(name, (serializer,), {"omittable": True})


def conformed(serializer: type[PayloadSerializer], data: Any) -> dict[str, Any]:
    """``data`` checked by ``serializer``; a mismatch raises the ``ValidationError`` answered with 422."""
    checked = serializer(data=data)
    checked.is_valid(raise_exception=True)
    return checked.validated_data


def exception_handler(exc: Exception, context: dict[str, Any]):
    """DRF's handler, answering an invalid payload with 422 as every other target does."""
    response = views.exception_handler(exc, context)
    if isinstance(exc, serializers.ValidationError):
        response.status_code = status.HTTP_422_UNPROCESSABLE_ENTITY
    return response
