from typing import Any

from fastapi import APIRouter, HTTPException, Request
from fastapi.encoders import jsonable_encoder
{% if ctx.session.uses_cookie %}
from fastapi.responses import JSONResponse
{% endif %}

from dependencies.access import Roles
from dependencies.login_codes import redeem_login_code
from dependencies.repositories import repository
from dependencies.session_tokens import issue_session
{% if ctx.session.uses_cookie %}
from dependencies.session_cookie import issue_csrf_token, set_session_cookies
{% endif %}

router = APIRouter()

# identity collection -> (id field, where its records keep their roles)
_IDENTITIES: dict[str, tuple[str, Roles]] = {
{% for identity in auth.identity_collections %}
    "{{ identity.name }}": ({{ identity.id_field | py_literal }}, {{ identity.role_store | py_literal }}),
{% endfor %}
}


@router.post("/auth/exchange")
async def exchange_login_code(request: Request, payload: dict[str, str]) -> Any:
    code = payload.get("code")
    if not code:
        raise HTTPException(status_code=400, detail="Missing code")
    redeemed = await redeem_login_code(code)
    if redeemed is None:
        raise HTTPException(status_code=401, detail="Invalid or expired code")
    subject, identity_collection, _ = redeemed
    id_field, roles = _IDENTITIES[identity_collection]
    record = await repository(identity_collection).find_by(id_field, subject)
    if record is None:
        raise HTTPException(status_code=401, detail="Invalid or expired code")
    session = await issue_session(subject, identity_collection)
    signed_in = jsonable_encoder(roles.signed_in(record))
{% if ctx.session.uses_cookie %}
    csrf_token = issue_csrf_token()
    response = JSONResponse({**signed_in, "csrf_token": csrf_token})
    set_session_cookies(response, request, session["token"], csrf_token{% if ctx.session.refresh %}, session["refresh_token"]{% endif %})
    return response
{% else %}
    return {**session, **signed_in}
{% endif %}
{% for col in auth.identity_collections %}
{% set ext_providers = [] %}
{% for binding in col.bindings %}
{% set _p = auth.providers.get(binding.provider) %}
{% if _p and not _p.is_idp %}
{% set _ = ext_providers.append({"name": binding.provider, "type": _p.type}) %}
{% endif %}
{% endfor %}
{% if ext_providers %}


@router.get("/{{ col.name }}/auth/providers")
async def list_{{ col.name }}_auth_providers() -> list[dict[str, str]]:
    return {{ ext_providers | tojson }}
{% endif %}
{% endfor %}
