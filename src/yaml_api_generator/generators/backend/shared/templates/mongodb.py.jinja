from pymongo import AsyncMongoClient

from {{ settings_module }} import settings
from {{ runtime_package }}mongo_lifecycle import MongoLifecycle


_client: AsyncMongoClient | None = None
_db = None


def connect_db() -> None:
    global _client, _db
    _client = AsyncMongoClient(settings.MONGO_URI)
    _db = _client[settings.MONGO_DB]


async def close_db() -> None:
    global _client, _db
    if _client is not None:
        await _client.close()
        _client = None
        _db = None


def get_database():
    if _db is None:
        raise RuntimeError("Database not connected")
    return _db


async def initialize_indexes(unique_indexes: dict[str, dict]) -> None:
    db = get_database()
    for collection_name, index in unique_indexes.items():
        for field_name in index["fields"]:
            await MongoLifecycle(index["lifecycle"]).keep_unique(db[collection_name], field_name)
