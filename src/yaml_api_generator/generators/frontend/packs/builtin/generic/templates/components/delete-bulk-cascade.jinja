{% from 'macros/delete.jinja' import deletion %}
{% set relations = props.relations.value if props.relations else [] %}
{% call deletion(entity, ['onConfirm']) %}
<h3 className="font-title text-xl text-wf-ink mb-1">Delete {{ props.count.value }} {{ entity.repository_name }}?</h3>
<p className="text-sm text-wf-ink-dim mb-4">This action is irreversible. Review what will be affected.</p>
{% if relations %}
<div className="mb-4 rounded-wf border border-wf-danger/30 bg-wf-danger-soft px-4 py-3">
  <p className="text-xs font-medium text-wf-danger mb-2 uppercase tracking-wide">Related records affected</p>
  <ul className="space-y-1">
    {% for relation in relations %}
    <li className="text-sm text-wf-ink">{{ relation }}</li>
    {% endfor %}
  </ul>
</div>
{% endif %}
<div className="flex items-center justify-end gap-2">
  <button onClick={cancel} disabled={loading} className="wf-btn">Cancel</button>
  <button onClick={() => remove(onConfirm)} disabled={loading} className="wf-btn wf-btn-danger">
    {loading ? 'Deleting...' : 'Delete {{ props.count.value }} {{ entity.repository_name }}'}
  </button>
</div>
{% endcall %}
