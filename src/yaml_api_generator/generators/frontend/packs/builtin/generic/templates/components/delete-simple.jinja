{% from 'macros/delete.jinja' import deletion %}
{% set label = props.entity.value if props.entity else entity.name | title %}
{% call deletion(entity, ['onConfirm']) %}
<h3 className="font-title text-xl text-wf-ink mb-2">Delete this {{ label }}?</h3>
<p className="text-sm text-wf-ink-dim mb-6">This {{ label }} will be permanently removed. This action cannot be undone.</p>
<div className="flex items-center justify-end gap-2">
  <button onClick={cancel} disabled={loading} className="wf-btn">Cancel</button>
  <button onClick={() => remove(onConfirm)} disabled={loading} className="wf-btn wf-btn-danger">
    {loading ? 'Deleting...' : 'Delete'}
  </button>
</div>
{% endcall %}
