{% from 'macros/delete.jinja' import deletion %}
{% set label = props.entity.value if props.entity else entity.name | title %}
{% call deletion(entity, ['onArchive'] if entity.removal else ['onDelete']) %}
{% if entity.removal %}
<h3 className="font-title text-xl text-wf-ink mb-1">Archive this {{ label }}?</h3>
<p className="text-sm text-wf-ink-dim mb-6">The {{ label }} disappears from every list and lookup; its data stays stored.</p>
<div className="flex items-center justify-end gap-2">
  <button onClick={cancel} disabled={loading} className="wf-btn">Cancel</button>
  <button onClick={() => remove(onArchive)} disabled={loading} className="wf-btn wf-btn-primary">
    {loading ? 'Archiving...' : 'Archive'}
  </button>
</div>
{% else %}
<h3 className="font-title text-xl text-wf-ink mb-1">Delete this {{ label }} permanently?</h3>
<p className="text-sm text-wf-ink-dim mb-6">The {{ label }} and its data are erased. This action cannot be undone.</p>
<div className="flex items-center justify-end gap-2">
  <button onClick={cancel} disabled={loading} className="wf-btn">Cancel</button>
  <button onClick={() => remove(onDelete)} disabled={loading} className="wf-btn wf-btn-danger">
    {loading ? 'Deleting...' : 'Delete permanently'}
  </button>
</div>
{% endif %}
{% endcall %}
