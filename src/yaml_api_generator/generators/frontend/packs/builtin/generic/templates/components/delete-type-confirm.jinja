{% from 'macros/delete.jinja' import deletion %}
{% set label = props.entity.value if props.entity else entity.name | title %}
{% set confirm_text = props.confirm_text.value if props.confirm_text else entity.name %}
{% call deletion(entity, ['onConfirm']) %}
<TypedConfirmation text={{ confirm_text | tojson }}>
  {(confirmed) => (
    <>
      <h3 className="font-title text-xl text-wf-ink mb-1">Delete {{ label }} permanently?</h3>
      <p className="text-sm text-wf-ink-dim mb-4">This cannot be undone. All associated data will be lost.</p>
      <div className="flex items-center justify-end gap-2">
        <button onClick={cancel} disabled={loading} className="wf-btn">Cancel</button>
        <button
          onClick={() => remove(onConfirm)}
          disabled={!confirmed || loading}
          className="wf-btn wf-btn-danger disabled:opacity-40 disabled:cursor-not-allowed"
        >
          {loading ? 'Deleting...' : 'Delete permanently'}
        </button>
      </div>
    </>
  )}
</TypedConfirmation>
{% endcall %}

import type { ReactNode } from 'react';

/** Asks for `text` to be typed before its content counts as confirmed. */
function TypedConfirmation({ text, children }: { text: string; children: (confirmed: boolean) => ReactNode }) {
  const [typed, setTyped] = useState('');
  return (
    <>
      <p className="text-xs text-wf-ink-dim mb-1.5">
        Type <span className="wf-mono text-wf-ink">{text}</span> to confirm:
      </p>
      <input
        type="text"
        aria-label="Confirmation"
        value={typed}
        onChange={(e) => setTyped(e.target.value)}
        placeholder={text}
        className="wf-input mb-5 w-full"
        autoFocus
      />
      {children(typed === text)}
    </>
  );
}
