{% from 'macros/field_input.jinja' import field_input, control_imports %}
import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { useRecordForm } from '../__generated__/useRecordForm';
{{ control_imports(entity.writable_fields) }}

interface {{ entity.name | pascal_case }}SectionedFormProps {
  entityId?: string;
  basePath?: string;
}

{% set all_fields = entity.writable_fields %}
{% set groups = [
  ('Basics', 'Essential information', ['title', 'name', 'displayName', 'slug', 'email', 'username']),
  ('Content', 'Main content and descriptions', ['content', 'body', 'description', 'excerpt', 'bio', 'summary']),
  ('Publishing', 'Visibility and scheduling', ['status', 'publishedAt', 'publishedOn', 'scheduledAt'] + all_fields | selectattr('type', 'equalto', 'enum') | map(attribute='name') | list),
  ('SEO', 'Search engine optimization', ['metaTitle', 'metaDescription', 'keywords', 'canonicalUrl', 'ogTitle', 'ogImage']),
] %}
{% set given = props.sections.value if props.sections else groups %}
{% set sections = [] %}
{% for section in given %}
{% set label, description, names = (section.title, '', section.fields) if section is mapping else section %}
{% set fields = all_fields | selectattr('name', 'in', names) | list %}
{% if fields or loop.first %}
{% set _ = sections.append({'label': label, 'description': description, 'fields': fields}) %}
{% endif %}
{% endfor %}
{% set placed = sections | map(attribute='fields') | sum(start=[]) | map(attribute='name') | list %}
{% set rest = all_fields | rejectattr('name', 'in', placed) | list %}
{% if rest %}
{% set _ = sections.append({'label': 'Other', 'description': 'Additional configuration', 'fields': rest}) %}
{% endif %}

const SECTIONS = {{ sections | map(attribute='label') | list | tojson }};

export function {{ entity.name | pascal_case }}SectionedForm({
  entityId,
  basePath = '{{ view.path if view else "/" }}'
}: {{ entity.name | pascal_case }}SectionedFormProps) {
  const { values, setValue, mode, submit } = useRecordForm({{ entity.name | tojson }}, entityId);
  const [activeSection, setActiveSection] = useState(SECTIONS[0]);
  const [submitting, setSubmitting] = useState(false);
  const [hasChanges, setHasChanges] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const navigate = useNavigate();

  const change = (name: string, value: unknown) => {
    setValue(name, value);
    setHasChanges(true);
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setSubmitting(true);
    setError(null);

    try {
      const result = await submit();
      navigate(`${basePath}/${result.{{ entity.pk_field }}}`);
    } catch (err: unknown) {
      setError(err instanceof Error ? err.message : 'Unexpected error');
      setSubmitting(false);
    }
  };

  return (
    <div className="min-h-screen bg-wf-bg">
      {/* Toolbar */}
      <div className="wf-toolbar px-5 py-3 border-b border-wf-line bg-wf-surface sticky top-0 z-10">
        <h1 className="font-title text-base text-wf-ink flex-1">
          {mode === 'create' ? 'New' : 'Edit'} {{ entity.name | title }}
        </h1>
        {hasChanges && (
          <span className="wf-badge wf-badge-warn">unsaved changes</span>
        )}
        <button type="button" onClick={() => navigate(-1)} className="wf-btn">
          Discard
        </button>
        <button type="submit" form="sectioned-form" disabled={submitting} className="wf-btn wf-btn-primary">
          {submitting ? 'Saving...' : 'Save'}
        </button>
      </div>

      {error && (
        <div className="mx-6 mt-4 p-4 bg-wf-danger-soft border-l-[3px] border-wf-danger rounded-wf">
          <p className="text-wf-ink text-sm">{error}</p>
        </div>
      )}

      {/* Grid layout: 180px sidebar + 1fr main */}
      <div className="flex" style={{ "{{" }} minHeight: 'calc(100vh - 49px)' {{ "}}" }}>
        {/* Section nav sidebar */}
        <nav
          className="bg-wf-surface border-r border-wf-line flex flex-col gap-0.5 p-3 pt-5"
          style={{ "{{" }} width: '180px', flexShrink: 0 {{ "}}" }}
        >
          {SECTIONS.map(section => (
            <button
              key={section}
              type="button"
              onClick={() => setActiveSection(section)}
              className={`wf-sidebar-item text-left ${activeSection === section ? 'is-active' : ''}`}
            >
              <span
                className="w-1.5 h-1.5 rounded-full flex-shrink-0"
                style={{ "{{" }} background: activeSection === section ? 'var(--wf-accent)' : 'var(--wf-line-strong)' {{ "}}" }}
              />
              {section}
            </button>
          ))}
        </nav>

        {/* Scrollable main content */}
        <main className="flex-1 overflow-y-auto">
          <form id="sectioned-form" onSubmit={handleSubmit} className="max-w-2xl mx-auto py-8 px-6">
            {% for section in sections %}
            {activeSection === {{ section.label | tojson }} && (
              <div>
                <h2 className="font-title text-xl text-wf-ink mb-1">{{ section.label }}</h2>
                {% if section.description %}
                <p className="text-wf-ink-dim text-sm mb-6">{{ section.description }}</p>
                {% endif %}
                <hr className="border-wf-line mb-6" />
                <div className="space-y-4">
                  {% for field in section.fields %}
                  {{ field_input(field, setter='change') }}
                  {% endfor %}
                  {% if loop.first %}
                  {% for field in entity.credential_fields %}
                  {mode === 'create' && (
                  {{ field_input(field, setter='change') }}
                  )}
                  {% endfor %}
                  {% endif %}
                </div>
              </div>
            )}
            {% endfor %}
          </form>
        </main>
      </div>
    </div>
  );
}

export default {{ entity.name | pascal_case }}SectionedForm;
