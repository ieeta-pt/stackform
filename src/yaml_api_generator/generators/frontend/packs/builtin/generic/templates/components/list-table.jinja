{% from 'macros/access.jinja' import allowed %}
{% from 'macros/listing.jinja' import search_box, pager %}
{% set roles = props.field_roles.value if props.field_roles is defined else {} %}
{% set role_names = roles.values() | select('in', entity.fields) | list %}
{% set other_names = entity.fields | reject('in', role_names) | list %}
{% set columns = props.columns.value if props.columns is defined else (role_names + other_names)[:4] %}
{% set selectable = props.selectable.value %}
import { useEffect, useState } from 'react';
import { Link, useNavigate } from 'react-router-dom';
import { Allowed, useAuth } from '../__generated__/App';
import { displayValue, listRecords } from '../__generated__/records';
import { useListing } from '../__generated__/listing';

interface {{ entity.name | pascal_case }} {
  {{ entity.pk_field }}: string;
  {% for field in entity.fields.values() %}
  {{ field.name }}: {% if field.type == 'string' %}string{% elif field.type == 'number' %}number{% elif field.type == 'boolean' %}boolean{% else %}any{% endif %};
  {% endfor %}
  [field: string]: unknown;
}

const COLUMNS: string[] = {{ columns | tojson }};

export default function {{ view.name | pascal_case }}() {
  const [items, setItems] = useState<{{ entity.name | pascal_case }}[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  {% if selectable %}
  const [selectedIds, setSelectedIds] = useState<Set<string>>(new Set());
  {% endif %}
  const listing = useListing(items, COLUMNS, {{ props.pagination.value | tojson }});
  const { token } = useAuth();
  const navigate = useNavigate();

  useEffect(() => {
    const headers: Record<string, string> = {};
    if (token) headers['Authorization'] = `Bearer ${token}`;

    listRecords('{{ entity.name }}', headers)
      .then(data => {
        setItems(data);
        setLoading(false);
      })
      .catch(err => {
        setError(err.message);
        setLoading(false);
      });
  }, [token]);
  {% if selectable %}

  const toggleSelect = (id: string) => {
    setSelectedIds(prev => {
      const next = new Set(prev);
      if (next.has(id)) next.delete(id);
      else next.add(id);
      return next;
    });
  };

  const toggleSelectAll = () => {
    if (selectedIds.size === listing.rows.length) {
      setSelectedIds(new Set());
    } else {
      setSelectedIds(new Set(listing.rows.map(i => i.{{ entity.pk_field }})));
    }
  };
  {% endif %}

  if (loading) {
    return (
      <div className="flex items-center justify-center h-full">
        <div className="text-wf-ink-dim">Loading...</div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="p-6">
        <div className="bg-wf-danger-soft border-l-[3px] border-wf-danger rounded-wf p-4">
          <p className="text-wf-ink font-medium mb-1">Error loading data</p>
          <p className="text-wf-ink-dim text-sm">{error}</p>
        </div>
      </div>
    );
  }

  if (items.length === 0) {
    return (
      <div className="flex items-center justify-center h-full">
        <div className="text-center p-12 border-[1.5px] border-dashed border-wf-line rounded-lg max-w-md">
          <div className="w-[60px] h-[60px] mx-auto mb-4 border-[1.5px] border-dashed border-wf-line rounded-lg flex items-center justify-center">
            <span className="font-title text-2xl text-wf-ink-faint">∅</span>
          </div>
          <h3 className="font-title text-xl text-wf-ink mb-2">No {{ entity.name | lower }}s yet</h3>
          {% call allowed(entity, 'create') %}
          <p className="text-wf-ink-dim text-sm mb-4">Create your first record to get started.</p>
          <button
            onClick={() => navigate('{{ view.path }}/new')}
            className="wf-btn wf-btn-primary"
          >
            + New {{ entity.name | title }}
          </button>
          {% endcall %}
        </div>
      </div>
    );
  }

  return (
    <div className="h-full flex flex-col">
      <div className="wf-toolbar px-6 pt-4">
        <h1 className="font-title text-2xl text-wf-ink">{{ entity.name | title }}</h1>
        <span className="wf-mono">{listing.found} records</span>
        {% if selectable %}
        <span className="wf-mono">{selectedIds.size} selected</span>
        {% endif %}
        <div className="flex-1" />
        {% if props.searchable.value %}
        {{ search_box() }}
        {% endif %}
        {% call allowed(entity, 'create') %}
        <button
          onClick={() => navigate('{{ view.path }}/new')}
          className="wf-btn wf-btn-primary"
        >
          + New
        </button>
        {% endcall %}
      </div>

      <div className="flex-1 overflow-auto px-6 pb-6">
        <div className="border border-wf-line rounded-wf overflow-hidden bg-wf-surface">
          <table className="wf-table">
            <thead>
              <tr>
                {% if selectable %}
                <th className="w-10">
                  <input
                    type="checkbox"
                    aria-label="Select all"
                    checked={selectedIds.size === listing.rows.length && listing.rows.length > 0}
                    onChange={toggleSelectAll}
                    className="w-4 h-4 rounded border-wf-line-strong accent-wf-accent"
                  />
                </th>
                {% endif %}
                {% for column in columns %}
                {% if props.sortable.value %}
                <th aria-sort={listing.sort?.field === {{ column | tojson }} ? (listing.sort.descending ? 'descending' : 'ascending') : 'none'}>
                  <button type="button" onClick={() => listing.sortBy({{ column | tojson }})}>{{ column | title }}</button>
                </th>
                {% else %}
                <th>{{ column | title }}</th>
                {% endif %}
                {% endfor %}
                <th className="w-16"></th>
              </tr>
            </thead>
            <tbody>
              {listing.rows.map((item) => (
                <tr
                  key={item.{{ entity.pk_field }}}
                  {% if selectable %}
                  className={selectedIds.has(item.{{ entity.pk_field }}) ? 'is-selected' : ''}
                  {% endif %}
                >
                  {% if selectable %}
                  <td>
                    <input
                      type="checkbox"
                      aria-label="Select"
                      checked={selectedIds.has(item.{{ entity.pk_field }})}
                      onChange={() => toggleSelect(item.{{ entity.pk_field }})}
                      className="w-4 h-4 rounded border-wf-line-strong accent-wf-accent"
                    />
                  </td>
                  {% endif %}
                  {% for column in columns %}
                  <td>
                    {% if entity.fields[column] is defined and entity.fields[column].type == 'enum' %}
                    <span className="wf-badge">{displayValue(item[{{ column | tojson }}])}</span>
                    {% else %}
                    {displayValue(item[{{ column | tojson }}])}
                    {% endif %}
                  </td>
                  {% endfor %}
                  <td>
                    {% call allowed(entity, 'get') %}
                    <Link
                      to={`{{ view.path }}/${item.{{ entity.pk_field }}}`}
                      className="text-wf-accent hover:text-wf-accent-ink text-sm"
                    >
                      View
                    </Link>
                    {% endcall %}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {% if props.pagination.value %}
        {{ pager() }}
        {% endif %}
      </div>
    </div>
  );
}
